class PlayerInterface{
    - name : string
    - id   : unsigned int
    - hand : Hand

    + virtual chooseBorne() : void = 0;
    + virtual claim(Bord& bord) : void = 0;
    + virtual showHand() : void;
    + virtual chooseCard() : void = 0;
}

class AIPlayer{

    + AIPlayer(name : const string, id : unsigned int);
    + chooseBorne() override : void;
    + claim(bord : Bord) override : void;
    + chooseCard() override : void;
    + generateRandomNumber(maxNumber : unsigned int, minNumber : unsigned int) const : const unsigned int;

}

class HumanPlayer{

    + HumanPlayer(name : const string, id : unsigned int);
    + chooseBorne() override : void;
    + claim(bord : Bord) override : void;
    + chooseCard() override : void;

}

